  "objectives": [],
  "rules": [
    {
      "id": "focus-mainboard-first",
      "on": {
        "event": "click",
        "entity": "mainboard"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "focused"
        },
        "right": 0
      },
      "then": [
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        },
        {
          "type": "cameraFocus",
          "entity": "mainboard"
        }
      ]
    },
    {
      "id": "inspect-mainboard",
      "on": {
        "event": "click",
        "entity": "mainboard"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "mainboard",
          "color": "#35c98f"
        },
        {
          "type": "showPanel",
          "title": "PCB-01 mainboard",
          "body": "A four-layer printed circuit board with a copper pour, silkscreen legend and mounting holes at the corners. Every component is soldered to this plate - click the CPU, RAM, heatsink or power header to read about them.",
          "entity": "mainboard"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "inspect-cpu",
      "on": {
        "event": "click",
        "entity": "cpu-chip"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "cpu-chip",
          "color": "#4cc9f0"
        },
        {
          "type": "showPanel",
          "title": "CPU-8 core",
          "body": "The processor. Eight cores sit under a polished gold lid, dropped into the socket beside the RAM bank. A small secondary die handles cache traffic.",
          "entity": "cpu-chip"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "inspect-ram",
      "on": {
        "event": "click",
        "entity": "ram-bank"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "ram-bank",
          "color": "#7b8cff"
        },
        {
          "type": "showPanel",
          "title": "RAM bank DIMM-A",
          "body": "Two memory packages on a slim module, latched into the slot along the top edge of the board. Gold contact fingers run along the underside.",
          "entity": "ram-bank"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "inspect-connector",
      "on": {
        "event": "click",
        "entity": "power-connector"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "power-connector",
          "color": "#f4a261"
        },
        {
          "type": "showPanel",
          "title": "J1 power header",
          "body": "The main power inlet. Two gold pins carry twelve volts onto the board, where the copper pour spreads it to every regulator.",
          "entity": "power-connector"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "inspect-leds",
      "on": {
        "event": "click",
        "entity": "status-leds"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "status-leds",
          "color": "#ffe066"
        },
        {
          "type": "showPanel",
          "title": "LED status array",
          "body": "A green power lamp and a red fault lamp sharing one black carrier. They glow at a few milliamps and report the board state at a glance.",
          "entity": "status-leds"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "inspect-heatsink",
      "on": {
        "event": "click",
        "entity": "heatsink"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "heatsink",
          "color": "#dfe6ee"
        },
        {
          "type": "showPanel",
          "title": "Heatsink HS-1",
          "body": "Extruded aluminium fins on a flat base. Heat leaves the chip through the base plate and is carried away by the air between the fins.",
          "entity": "heatsink"
        },
        {
          "type": "playSound",
          "sound": "click"
        }
      ]
    },
    {
      "id": "hover-cpu-hint",
      "on": {
        "event": "hoverEnter",
        "entity": "cpu-chip"
      },
      "then": [
        {
          "type": "showMessage",
          "text": "CPU-8 core - click to inspect"
        }
      ]
    },
    {
      "id": "hover-mainboard-hint",
      "on": {
        "event": "hoverEnter",
        "entity": "mainboard"
      },
      "then": [
        {
          "type": "showMessage",
          "text": "PCB-01 mainboard - click to inspect"
        }
      ]
    }
  ],
  "scratch": {
    "focused": 0,
    "inspected": 0
  }
}
