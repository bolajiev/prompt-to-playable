  "objectives": [],
  "rules": [
    {
      "id": "start-blink",
      "on": {
        "event": "tick"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "blinkStarted"
        },
        "right": 0
      },
      "then": [
        {
          "type": "animate",
          "entity": "d1",
          "kind": "pulse",
          "speed": 0.9
        },
        {
          "type": "setVar",
          "key": "blinkStarted",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-u1",
      "on": {
        "event": "click",
        "entity": "u1"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "u1"
        },
        {
          "type": "setColor",
          "entity": "u1",
          "color": "#4cc9f0"
        },
        {
          "type": "showPanel",
          "title": "U1 - Motor control MCU",
          "body": "The board's brain: a 32-bit motor-control microcontroller running the commutation loop at 20 kHz. It reads the hall sensors, the current shunt and the on-die temperature diode, then drives the three PWM gate outputs. Pins: 48 total - 12 PWM, 8 ADC, 6 hall inputs, 4 power, 6 ground, 12 spare GPIO.",
          "entity": "u1"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-u2",
      "on": {
        "event": "click",
        "entity": "u2"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "u2"
        },
        {
          "type": "setColor",
          "entity": "u2",
          "color": "#b388ff"
        },
        {
          "type": "showPanel",
          "title": "U2 - Half-bridge gate driver",
          "body": "Level-shifts the MCU's 3.3 V PWM up to the 12 V power rail and adds dead-time so the high and low MOSFETs can never conduct at the same time. Pins: VCC, VDD, GND, HIN, LIN, HOUT, LOUT, VB, VS.",
          "entity": "u2"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-u3",
      "on": {
        "event": "click",
        "entity": "u3"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "u3"
        },
        {
          "type": "setColor",
          "entity": "u3",
          "color": "#ff9f68"
        },
        {
          "type": "showPanel",
          "title": "U3 - 5 V low-dropout regulator",
          "body": "Steps the 12 V input down to a clean 5 V rail for the hall sensors and the CAN transceiver, with a 300 mV dropout so it keeps regulating during motor brown-outs. Pins: VIN, VOUT, EN, BYP, GND.",
          "entity": "u3"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-pi1",
      "on": {
        "event": "click",
        "entity": "pi1"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "pi1"
        },
        {
          "type": "setColor",
          "entity": "pi1",
          "color": "#ffd166"
        },
        {
          "type": "showPanel",
          "title": "PI1 - Programming / debug header",
          "body": "8-pin 2.54 mm header used to flash firmware and probe the running board: SWDIO, SWCLK, 3.3 V, 5 V, GND, RESET, plus UART TX and RX broken out for a logic analyser.",
          "entity": "pi1"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-c1",
      "on": {
        "event": "click",
        "entity": "c1"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "c1"
        },
        {
          "type": "setColor",
          "entity": "c1",
          "color": "#8ecae6"
        },
        {
          "type": "showPanel",
          "title": "C1 - Bulk input capacitor",
          "body": "470 uF low-ESR electrolytic can holding the 12 V rail steady while the motor windings switch at 20 kHz. Rated 25 V and 105 C, it supplies the current spikes the supply leads cannot.",
          "entity": "c1"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-d1",
      "on": {
        "event": "click",
        "entity": "d1"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "d1"
        },
        {
          "type": "setColor",
          "entity": "d1",
          "color": "#7bffb2"
        },
        {
          "type": "showPanel",
          "title": "D1 - Heartbeat status LED",
          "body": "Green status LED wired to the MCU heartbeat line through a 330 ohm resistor: it pulses while the commutation loop runs and holds solid when the driver latches a fault. Anode to PA5, cathode to GND.",
          "entity": "d1"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "reset-view",
      "on": {
        "event": "click",
        "entity": "reset-pad"
      },
      "then": [
        {
          "type": "hidePanel"
        },
        {
          "type": "cameraFocus"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 0
        }
      ]
    }
  ],
  "scratch": {
    "focused": 0,
    "blinkStarted": 0
  }
}
