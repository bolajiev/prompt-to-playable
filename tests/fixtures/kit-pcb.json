  "objectives": [],
  "rules": [
    {
      "id": "start-heartbeat",
      "on": {
        "event": "tick"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "heartbeatStarted"
        },
        "right": 0
      },
      "then": [
        {
          "type": "animate",
          "entity": "d3",
          "kind": "pulse",
          "speed": 0.8
        },
        {
          "type": "setVar",
          "key": "heartbeatStarted",
          "value": 1
        }
      ]
    },
    {
      "id": "focus-first-part",
      "on": {
        "event": "click",
        "entity": "u1"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "focused"
        },
        "right": 0
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "u1"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-u1",
      "on": {
        "event": "click",
        "entity": "u1"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "u1",
          "color": "#4cc9f0"
        },
        {
          "type": "showPanel",
          "title": "U1 - Sensor MCU",
          "body": "32-bit ARM Cortex-M4 microcontroller, the board's brain. It runs the sampling loop, clocks the SPI bus and drives the status LEDs from the 3.3 V rail. Pins: VDD, VSS, NRST, SWDIO, SWCLK, BOOT0, PA0-PA15 (sensor bus), PB0-PB15 (GPIO).",
          "entity": "u1"
        }
      ]
    },
    {
      "id": "inspect-u2",
      "on": {
        "event": "click",
        "entity": "u2"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "u2",
          "color": "#b388ff"
        },
        {
          "type": "showPanel",
          "title": "U2 - Flash memory",
          "body": "8 MB SPI NOR flash holding the firmware image, the bootloader and the sensor calibration table. Pins: VCC, GND, CLK, MOSI, MISO, CS, WP, HOLD. It is reflashed over the PI1 header.",
          "entity": "u2"
        }
      ]
    },
    {
      "id": "inspect-u3",
      "on": {
        "event": "click",
        "entity": "u3"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "u3",
          "color": "#ff9f68"
        },
        {
          "type": "showPanel",
          "title": "U3 - 3.3 V LDO regulator",
          "body": "Low-dropout linear regulator that steps the 5 V input down to a clean 3.3 V for the logic side. Its input and output are smoothed by the nearby capacitors C1 (bulk) and C2 (decoupling). Pins: VIN, VOUT, EN, BYP, GND.",
          "entity": "u3"
        }
      ]
    },
    {
      "id": "inspect-header",
      "on": {
        "event": "click",
        "entity": "pi1"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "pi1",
          "color": "#ffd166"
        },
        {
          "type": "showPanel",
          "title": "PI1 - 10-pin expansion header",
          "body": "2.54 mm breakout for probing and programming the node. Pin order: 3V3, GND, SDA, SCL, TX, RX, MISO, MOSI, CS, 5V. I2C and UART are live whenever the firmware is running.",
          "entity": "pi1"
        }
      ]
    },
    {
      "id": "inspect-leds",
      "on": {
        "event": "click",
        "entity": "d3"
      },
      "then": [
        {
          "type": "setColor",
          "entity": "d3",
          "color": "#ff8fa3"
        },
        {
          "type": "showPanel",
          "title": "D1 / D2 / D3 - Status LEDs",
          "body": "Three emissive indicators on the front of the board: D1 (green) shows power good, D2 (amber) blinks on sensor activity, and D3 (red) pulses as the firmware heartbeat - one pulse per sampling cycle.",
          "entity": "d3"
        }
      ]
    },
    {
      "id": "reset-view",
      "on": {
        "event": "click",
        "entity": "reset-pad"
      },
      "then": [
        {
          "type": "hidePanel"
        },
        {
          "type": "cameraFocus"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 0
        }
      ]
    }
  ],
  "scratch": {
    "focused": 0,
    "heartbeatStarted": 0
  }
}
