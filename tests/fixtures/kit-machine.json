  "objectives": [],
  "rules": [
    {
      "id": "inspect-base",
      "on": {
        "event": "click",
        "entity": "arm-base"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-base"
        },
        {
          "type": "showPanel",
          "title": "BASE - yaw turret",
          "body": "A 360-degree geared turret on a cast base. The Base yaw slider spins the whole arm left and right about the vertical axis.",
          "entity": "arm-base"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-shoulder",
      "on": {
        "event": "click",
        "entity": "arm-shoulder"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-shoulder"
        },
        {
          "type": "showPanel",
          "title": "SHOULDER - lift servo",
          "body": "Metal-gear servo with about 90 degrees of lift either way. It carries the upper link, so it is the strongest joint on the rig. Drag the Shoulder slider and watch the link sweep.",
          "entity": "arm-shoulder"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-elbow",
      "on": {
        "event": "click",
        "entity": "arm-elbow"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-elbow"
        },
        {
          "type": "showPanel",
          "title": "ELBOW - fold servo",
          "body": "Second servo joint, about 69 degrees of bend. It folds the forearm in and out; pair it with the shoulder slider to reach across the work mat.",
          "entity": "arm-elbow"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-wrist",
      "on": {
        "event": "click",
        "entity": "arm-wrist"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-wrist"
        },
        {
          "type": "showPanel",
          "title": "WRIST - pitch joint",
          "body": "Compact pitch joint that angles the gripper up and down. The Wrist slider tilts the tool plate for precise approach angles.",
          "entity": "arm-wrist"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-grip",
      "on": {
        "event": "click",
        "entity": "arm-grip"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-grip"
        },
        {
          "type": "showPanel",
          "title": "GRIP - parallel gripper",
          "body": "Two 70 mm jaws on the wrist. The Grip toggle opens and closes the upper jaw to grab small parts; press WAVE to make the gripper bob hello.",
          "entity": "arm-grip"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    }
  ],
  "controls": [
    {
      "id": "base-yaw",
      "type": "slider",
      "label": "Base yaw",
      "min": -1.2,
      "max": 1.2,
      "step": 0.05,
      "value": 0,
      "bind": {
        "entity": "arm-base",
        "property": "rotation.y",
        "scale": 1.4
      }
    },
    {
      "id": "shoulder",
      "type": "slider",
      "label": "Shoulder lift",
      "min": -0.8,
      "max": 1.1,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-shoulder",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "elbow",
      "type": "slider",
      "label": "Elbow bend",
      "min": -1.2,
      "max": 1.2,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-elbow",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "wrist",
      "type": "slider",
      "label": "Wrist pitch",
      "min": -0.9,
      "max": 0.9,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-wrist",
        "property": "rotation.z",
        "scale": 1.1
      }
    },
    {
      "id": "grip",
      "type": "toggle",
      "label": "Grip open",
      "value": 0,
      "bind": {
        "entity": "arm-grip",
        "property": "rotation.z",
        "scale": 0.55,
        "var": "grip"
      }
    },
    {
      "id": "home",
      "type": "button",
      "label": "HOME",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "slide",
            "to": [
              5,
              1.35,
              0
            ],
            "duration": 600
          },
          {
            "type": "setVar",
            "key": "homed",
            "value": 1
          }
        ]
      }
    },
    {
      "id": "wave",
      "type": "button",
      "label": "WAVE",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "bob",
            "amplitude": 0.3,
            "speed": 1.5
          },
          {
            "type": "setVar",
            "key": "waved",
            "value": 1
          }
        ]
      }
    }
  ],
  "scratch": {
    "focused": 0,
    "grip": 0,
    "homed": 0,
    "waved": 0
  }
}
