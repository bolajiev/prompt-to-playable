  "objectives": [],
  "rules": [
    {
      "id": "inspect-base",
      "on": {
        "event": "click",
        "entity": "arm-base"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-base"
        },
        {
          "type": "showPanel",
          "title": "BASE - azimuth turret",
          "body": "NEMA-17 stepper under a 2.4-unit turntable. It swings the whole arm about the vertical axis, roughly 45 degrees either way on the Base yaw slider. The cyan collar is the rotary bearing race.",
          "entity": "arm-base"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-shoulder",
      "on": {
        "event": "click",
        "entity": "arm-shoulder"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-shoulder"
        },
        {
          "type": "showPanel",
          "title": "SHOULDER - main lift servo",
          "body": "High-torque metal-gear servo bolted to the turret top. The silver capsule link is 2.6 units long and carries every joint above it, so this is the load-bearing axis. Drive the Shoulder lift slider to sweep the link.",
          "entity": "arm-shoulder"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-elbow",
      "on": {
        "event": "click",
        "entity": "arm-elbow"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-elbow"
        },
        {
          "type": "showPanel",
          "title": "ELBOW - forearm fold",
          "body": "Mid-size servo with an amber hub, about 70 degrees of bend each way. It folds the 2.7-unit forearm sideways from the upper link; combine it with the shoulder to reach across the mat.",
          "entity": "arm-elbow"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-wrist",
      "on": {
        "event": "click",
        "entity": "arm-wrist"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-wrist"
        },
        {
          "type": "showPanel",
          "title": "WRIST - tool pitch",
          "body": "Micro servo on the forearm tip with a 0.8-unit barrel. It pitches the tool plate up and down so the jaws can approach a part squarely. The lower jaw is fixed to this plate; the upper jaw rides on the next axis.",
          "entity": "arm-wrist"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-grip",
      "on": {
        "event": "click",
        "entity": "arm-grip"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-grip"
        },
        {
          "type": "showPanel",
          "title": "GRIP - parallel jaw",
          "body": "The upper 90 mm jaw swings on a 0.5-radian hinge against the fixed lower jaw. Flip the Grip toggle to open and close it, or hit WAVE and it will bob a greeting at you.",
          "entity": "arm-grip"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    }
  ],
  "controls": [
    {
      "id": "base-yaw",
      "type": "slider",
      "label": "Base yaw",
      "min": -1,
      "max": 1,
      "step": 0.05,
      "value": 0,
      "bind": {
        "entity": "arm-base",
        "property": "rotation.y",
        "scale": 1.6
      }
    },
    {
      "id": "shoulder-lift",
      "type": "slider",
      "label": "Shoulder lift",
      "min": -0.7,
      "max": 1,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-shoulder",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "elbow-bend",
      "type": "slider",
      "label": "Elbow bend",
      "min": -1,
      "max": 1,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-elbow",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "wrist-pitch",
      "type": "slider",
      "label": "Wrist pitch",
      "min": -0.8,
      "max": 0.8,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-wrist",
        "property": "rotation.z",
        "scale": 1.1
      }
    },
    {
      "id": "grip-open",
      "type": "toggle",
      "label": "Grip open",
      "value": 0,
      "bind": {
        "entity": "arm-grip",
        "property": "rotation.z",
        "scale": 0.5,
        "var": "grip"
      }
    },
    {
      "id": "home",
      "type": "button",
      "label": "HOME",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "slide",
            "to": [
              2.1,
              4.5,
              0
            ],
            "duration": 600
          },
          {
            "type": "setVar",
            "key": "homed",
            "value": 1
          },
          {
            "type": "showMessage",
            "text": "Home pose restored - jaws squared to the rest line."
          }
        ]
      }
    },
    {
      "id": "wave",
      "type": "button",
      "label": "WAVE",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "bob",
            "amplitude": 0.32,
            "speed": 1.4
          },
          {
            "type": "setVar",
            "key": "waved",
            "value": 1
          }
        ]
      }
    }
  ],
  "scratch": {
    "focused": 0,
    "grip": 0,
    "homed": 0,
    "waved": 0
  }
}
