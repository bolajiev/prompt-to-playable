  "objectives": [],
  "rules": [
    {
      "id": "inspect-base",
      "on": {
        "event": "click",
        "entity": "arm-base"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-base"
        },
        {
          "type": "showPanel",
          "title": "BASE - yaw turret",
          "body": "Cast plinth 2.4 units across with a planetary drive inside. It carries every joint above it and turns about the vertical axis, roughly 90 degrees each way, so the whole arm sweeps around the bench. Drag Base yaw to spin it.",
          "entity": "arm-base"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-shoulder",
      "on": {
        "event": "click",
        "entity": "arm-shoulder"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-shoulder"
        },
        {
          "type": "showPanel",
          "title": "SHOULDER - lift servo",
          "body": "Metal-gear servo bolted to the turret top, hub 0.8 units square. Its vertical link is 2.6 units tall and the elbow sits on the link tip, so this joint lifts the entire upper arm: move Shoulder lift and the elbow, wrist and gripper sweep with it.",
          "entity": "arm-shoulder"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-elbow",
      "on": {
        "event": "click",
        "entity": "arm-elbow"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-elbow"
        },
        {
          "type": "showPanel",
          "title": "ELBOW - fold servo",
          "body": "Amber hub servo with about 60 degrees of bend either side. The 2.7-unit forearm runs out along its local x axis and the wrist rides the far tip, so Elbow bend folds the tool in toward the turret or reaches it away.",
          "entity": "arm-elbow"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-wrist",
      "on": {
        "event": "click",
        "entity": "arm-wrist"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-wrist"
        },
        {
          "type": "showPanel",
          "title": "WRIST - pitch plate",
          "body": "Roller-bearing wrist, 0.88 units across, ending in a 1.2-unit tool plate. It sets the angle of the gripper without moving the arm: Wrist pitch sets the jaws up or down. The amber bead is a homing indicator.",
          "entity": "arm-wrist"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    },
    {
      "id": "inspect-grip",
      "on": {
        "event": "click",
        "entity": "arm-grip"
      },
      "then": [
        {
          "type": "cameraFocus",
          "entity": "arm-grip"
        },
        {
          "type": "showPanel",
          "title": "GRIP - parallel jaws",
          "body": "Two 90 mm jaws share the tool-plate hinge with soft pads on the tips. The Grip toggle swings them about half a radian to hold small parts; WAVE rocks the gripper hello and HOME slides it back to its rest pose.",
          "entity": "arm-grip"
        },
        {
          "type": "setVar",
          "key": "focused",
          "value": 1
        }
      ]
    }
  ],
  "controls": [
    {
      "id": "base-yaw",
      "type": "slider",
      "label": "Base yaw",
      "min": -1,
      "max": 1,
      "step": 0.05,
      "value": 0,
      "bind": {
        "entity": "arm-base",
        "property": "rotation.y",
        "scale": 1.6
      }
    },
    {
      "id": "shoulder",
      "type": "slider",
      "label": "Shoulder lift",
      "min": -0.7,
      "max": 1.1,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-shoulder",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "elbow",
      "type": "slider",
      "label": "Elbow bend",
      "min": -1,
      "max": 1,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-elbow",
        "property": "rotation.z",
        "scale": 1.2
      }
    },
    {
      "id": "wrist",
      "type": "slider",
      "label": "Wrist pitch",
      "min": -0.8,
      "max": 0.8,
      "step": 0.02,
      "value": 0,
      "bind": {
        "entity": "arm-wrist",
        "property": "rotation.z",
        "scale": 1.1
      }
    },
    {
      "id": "grip",
      "type": "toggle",
      "label": "Grip open",
      "value": 0,
      "bind": {
        "entity": "arm-grip",
        "property": "rotation.z",
        "scale": 0.5,
        "var": "grip"
      }
    },
    {
      "id": "home",
      "type": "button",
      "label": "HOME",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "slide",
            "to": [
              0,
              0,
              0
            ],
            "duration": 600
          },
          {
            "type": "setVar",
            "key": "homed",
            "value": 1
          },
          {
            "type": "showMessage",
            "text": "Home pose restored - gripper back on its tool plate."
          }
        ]
      }
    },
    {
      "id": "wave",
      "type": "button",
      "label": "WAVE",
      "bind": {
        "onPress": [
          {
            "type": "animate",
            "entity": "arm-grip",
            "kind": "bob",
            "amplitude": 0.3,
            "speed": 1.4
          },
          {
            "type": "setVar",
            "key": "waved",
            "value": 1
          },
          {
            "type": "showMessage",
            "text": "Gripper waving - the wrist is doing the work."
          }
        ]
      }
    }
  ],
  "scratch": {
    "focused": 0,
    "grip": 0,
    "homed": 0,
    "waved": 0
  }
}
