  "objectives": [],
  "rules": [
    {
      "id": "open-front-door",
      "on": {
        "event": "interact",
        "entity": "front-door"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "doorOpen"
        },
        "right": 0
      },
      "then": [
        {
          "type": "animate",
          "entity": "front-door",
          "kind": "slide",
          "to": [
            2.4,
            1.5,
            4.5
          ],
          "duration": 900
        },
        {
          "type": "openDoor",
          "entity": "front-door"
        },
        {
          "type": "setVar",
          "key": "doorOpen",
          "value": 1
        },
        {
          "type": "playSound",
          "sound": "door-open"
        },
        {
          "type": "showMessage",
          "text": "The front door slides open."
        }
      ]
    },
    {
      "id": "close-front-door",
      "on": {
        "event": "interact",
        "entity": "front-door"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "doorOpen"
        },
        "right": 1
      },
      "then": [
        {
          "type": "animate",
          "entity": "front-door",
          "kind": "slide",
          "to": [
            0,
            1.5,
            4.5
          ],
          "duration": 900
        },
        {
          "type": "setVar",
          "key": "doorOpen",
          "value": 0
        },
        {
          "type": "playSound",
          "sound": "door-close"
        },
        {
          "type": "showMessage",
          "text": "The front door slides shut."
        }
      ]
    },
    {
