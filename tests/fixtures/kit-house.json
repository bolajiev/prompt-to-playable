  "objectives": [],
  "rules": [
    {
      "id": "front-door-open",
      "on": {
        "event": "interact",
        "entity": "front-door"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "doorOpen"
        },
        "right": 0
      },
      "then": [
        {
          "type": "animate",
          "entity": "front-door",
          "kind": "slide",
          "to": [
            2.7,
            1.7,
            6.7
          ],
          "duration": 850
        },
        {
          "type": "openDoor",
          "entity": "front-door"
        },
        {
          "type": "setVar",
          "key": "doorOpen",
          "value": 1
        },
        {
          "type": "playSound",
          "sound": "door-slide"
        },
        {
          "type": "showMessage",
          "text": "The green door slides clear of the doorway."
        }
      ]
    },
    {
      "id": "front-door-close",
      "on": {
        "event": "interact",
        "entity": "front-door"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "doorOpen"
        },
        "right": 1
      },
      "then": [
        {
          "type": "animate",
          "entity": "front-door",
          "kind": "slide",
          "to": [
            0,
            1.7,
            6
          ],
          "duration": 850
        },
        {
          "type": "setVar",
          "key": "doorOpen",
          "value": 0
        },
        {
          "type": "playSound",
          "sound": "door-close"
        },
        {
          "type": "showMessage",
          "text": "The door slides back and seals the doorway."
        }
      ]
    },
    {
      "id": "pendant-lamp-off",
      "on": {
        "event": "interact",
        "entity": "pendant-lamp"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "lampOn"
        },
        "right": 1
      },
      "then": [
        {
          "type": "setVisible",
          "entity": "lamp-glow",
          "visible": false
        },
        {
          "type": "setColor",
          "entity": "pendant-lamp",
          "color": "#8e9aa3"
        },
        {
          "type": "setVar",
          "key": "lampOn",
          "value": 0
        },
        {
          "type": "playSound",
          "sound": "lamp-click"
        },
        {
          "type": "showMessage",
          "text": "The pendant lamp clicks off."
        }
      ]
    },
    {
      "id": "pendant-lamp-on",
      "on": {
        "event": "interact",
        "entity": "pendant-lamp"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "lampOn"
        },
        "right": 0
      },
      "then": [
        {
          "type": "setVisible",
          "entity": "lamp-glow",
          "visible": true
        },
        {
          "type": "setColor",
          "entity": "pendant-lamp",
          "color": "#ffd98a"
        },
        {
          "type": "setVar",
          "key": "lampOn",
          "value": 1
        },
        {
          "type": "playSound",
          "sound": "lamp-click"
        },
        {
          "type": "showMessage",
          "text": "The pendant lamp glows a warm amber."
        }
      ]
    }
  ],
  "scratch": {
    "doorOpen": 0,
    "lampOn": 1
  }
}
