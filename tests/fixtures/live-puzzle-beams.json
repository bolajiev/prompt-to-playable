          "type": "disable",
          "entity": "beam-switch-1"
        }
      ]
    },
    {
      "id": "trigger-2",
      "on": {
        "event": "interact",
        "entity": "beam-switch-2"
      },
      "then": [
        {
          "type": "objectiveProgress",
          "objective": "activate-beams",
          "by": 1
        },
        {
          "type": "disable",
          "entity": "beam-switch-2"
        }
      ]
    },
    {
      "id": "trigger-3",
      "on": {
        "event": "interact",
        "entity": "beam-switch-3"
      },
      "then": [
        {
          "type": "objectiveProgress",
          "objective": "activate-beams",
          "by": 1
        },
        {
          "type": "disable",
          "entity": "beam-switch-3"
        }
      ]
    },
    {
      "id": "win-condition",
      "on": {
        "event": "objectiveComplete",
        "objective": "activate-beams"
      },
      "then": [
        {
          "type": "openDoor",
          "entity": "exit-door"
        },
        {
          "type": "win",
          "message": "The gate is open!"
        }
      ]
    }
  ],
  "scratch": {}
