  "objectives": [
    {
      "id": "pass-checkpoints",
      "type": "collect",
      "description": "Pass all three checkpoints in order",
      "targets": [
        "checkpoint-1",
        "checkpoint-2",
        "checkpoint-3"
      ],
      "count": 3,
      "progress": 0,
      "status": "active"
    },
    {
      "id": "beat-the-clock",
      "type": "timeLimit",
      "description": "Finish the race before the clock runs out",
      "progress": 0,
      "time": 120,
      "status": "active"
    }
  ],
  "rules": [
    {
      "id": "cp1",
      "on": {
        "event": "playerEnter",
        "zone": "checkpoint-1"
      },
      "then": [
        {
          "type": "incVar",
          "key": "cp",
          "by": 1
        },
        {
          "type": "objectiveProgress",
          "objective": "pass-checkpoints",
          "by": 1
        },
        {
          "type": "showMessage",
          "text": "Checkpoint 1/3"
        }
      ]
    },
    {
      "id": "cp2",
      "on": {
        "event": "playerEnter",
        "zone": "checkpoint-2"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "cp"
        },
        "right": 1
      },
      "then": [
        {
          "type": "incVar",
          "key": "cp",
          "by": 1
        },
        {
          "type": "objectiveProgress",
          "objective": "pass-checkpoints",
          "by": 1
        },
        {
          "type": "showMessage",
          "text": "Checkpoint 2/3"
        }
      ]
    },
    {
      "id": "cp3",
      "on": {
        "event": "playerEnter",
        "zone": "checkpoint-3"
      },
      "if": {
        "op": "==",
        "left": {
          "var": "cp"
        },
        "right": 2
      },
      "then": [
        {
          "type": "incVar",
          "key": "cp",
          "by": 1
        },
        {
          "type": "setVar",
          "key": "lap",
          "value": 1
        },
        {
          "type": "objectiveProgress",
          "objective": "pass-checkpoints",
          "by": 1
        },
        {
          "type": "showMessage",
          "text": "Checkpoint 3/3"
        }
      ]
    },
    {
      "id": "race-won",
      "on": {
        "event": "objectiveComplete",
        "objective": "pass-checkpoints"
      },
      "then": [
        {
          "type": "win",
          "message": "Checkered flag!"
        }
      ]
    },
    {
      "id": "time-up",
      "on": {
        "event": "objectiveFailed",
        "objective": "beat-the-clock"
      },
      "then": [
        {
          "type": "lose",
          "message": "Time's up!"
        }
      ]
    }
  ],
  "scratch": {
    "cp": 0,
    "lap": 0
  }
