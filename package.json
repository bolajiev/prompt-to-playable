{
  "name": "prompt-to-playable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:web": "npm --workspace apps/web run build",
    "serve:prod": "node server/dist/index.js",
    "start": "npm run build && npm run build:web && npm run serve:prod",
    "dev": "echo 'run server + web separately'",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:corpus": "tsx scripts/eval-corpus.ts",
    "llm:smoke": "tsx scripts/llm-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "zod": "^3.23.8"
  }
}
