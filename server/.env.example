# Copy this file to server/.env (gitignored) and fill in real values.
# server/.env is read by scripts/llm-smoke.ts and the server at runtime.
OPENAI_API_KEY=
# Any OpenAI-compatible chat-completions endpoint, e.g.
# https://api.openai.com/v1 or https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional session id, required only for the OpenCode go gateway (sent as X-Session-Id).
OPENAI_SESSION_ID=
